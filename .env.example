# Application Configuration
NEXT_PUBLIC_APP_NAME=GLACIER AI Receptionist
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Backend Database
DATABASE_URL=postgresql://glacier_user:glacier_password@localhost:5432/glacier_ai
REDIS_URL=redis://localhost:6379/0

# Backend Security
SECRET_KEY=your-secret-key-change-in-production
PYTHONUNBUFFERED=1

# Authentication & Tokens
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-change-in-production
JWT_SECRET=your-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Third-party API Keys
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-your-anthropic-key

# Stripe Configuration
STRIPE_PUBLIC_KEY=pk_test_your_stripe_key
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Twilio Configuration
TWILIO_ACCOUNT_SID=AC_your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890

# SendGrid Configuration
SENDGRID_API_KEY=SG.your_sendgrid_key
SENDGRID_FROM_EMAIL=noreply@glacierai.com

# Google Cloud Configuration
GOOGLE_PROJECT_ID=your_google_project
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_APPLICATION_CREDENTIALS=path/to/credentials.json

# AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=us-east-1
AWS_S3_BUCKET=glacier-ai-bucket

# Email Configuration
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_email_password
MAIL_FROM=noreply@glacierai.com
MAIL_PORT=587

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Feature Flags
ENABLE_AI=true
ENABLE_VOICE=true
ENABLE_WHATSAPP=false
ENABLE_AUTOMATIONS=true

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_ENABLED=true

# Monitoring & Observability
SENTRY_DSN=https://your-sentry-dsn
DATADOG_API_KEY=your_datadog_key
SLACK_WEBHOOK=https://hooks.slack.com/services/your/slack/webhook
